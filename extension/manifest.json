{
  "manifest_version": 3,
  "name": "JobScanner AI Apply",
  "version": "1.0",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"]
    }
  ]
}
